# Pulse environment variables (server-side only; never prefix with NEXT_PUBLIC_).
# Copy to `.env.local` and fill in. Leave a key blank to run that source in MOCK MODE
# (seeded demo data is served instead of calling the real API).

# NewsAPI key (https://newsapi.org). Blank = mock news.
NEWS_API_KEY=

# TMDB v4 "API Read Access Token" (https://www.themoviedb.org/settings/api) — NOT the short v3 key. Blank = mock movies.
TMDB_API_KEY=

# Secret used to sign the pulse_session cookie. Use a long random string in real deployments.
# REQUIRED when NODE_ENV=production (`npm run build && npm start`): without it login returns 500
# and every request is treated as signed out. In `npm run dev` a built-in dev secret is used if blank.
AUTH_SECRET=change-me-to-a-long-random-string
